# --- Chagee Scraper Email Settings ---
# FILL THESE IN

CHAGEE_SMTP_SERVER=smtp.gmail.com
CHAGEE_SMTP_PORT=587

# Sender details (The account sending the mail)
CHAGEE_SENDER_EMAIL=your_email@gmail.com

# For Gmail, you should use an "App Password" (NOT your regular password)
# Visit: https://myaccount.google.com/apppasswords
CHAGEE_SENDER_PASSWORD=your_app_password_here

# Recipient details (Who gets the report)
CHAGEE_RECIPIENT_EMAIL=recipient_email@gmail.com
