# Copy this file to .env and fill in your values

# Qwen — used for all LLM tasks (article summaries, AI digest, browser-use vision fallback)
# Get key from https://bailian.console.aliyun.com/ (domestic) or https://bailian.console.alibabacloud.com/ (international)
QWEN_API_KEY=your_qwen_api_key_here

SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_app_password
RECIPIENT_EMAIL=destination@example.com
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465

# ---------------------------------------------------------------------------
# WeCom active push notifications
# ---------------------------------------------------------------------------
# Fill these after creating the production WeCom enterprise and self-built app.
# Do not use temporary test-enterprise credentials in production.
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TARGET_USER=
WECOM_TIMEOUT_SECONDS=10
# Optional: override default database path
# DB_PATH=news.db

# Flask secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ea92d7e003f5144addbfd674df3298915a3eb91accf9a0b26e9bb43a18d53a6f

# Whitelist: comma-separated emails allowed to sign in. Leave empty to allow all.
EMAIL_WHITELIST=

# Nitter fetch period in hours — controls two things at once:
#   1. How often the scheduler runs (e.g. 24 = once daily, 12 = twice daily)
#   2. Pagination stop threshold — tweets older than this many hours are skipped
NITTER_FETCH_PERIOD_HOURS=24
TOPIC_QUERY_SLEEP_SECONDS=3
GEMINI_API_KEY=
TOPIC_GOOGLE_SEARCH_MODEL=gemini-2.5-flash

# Seconds between Nitter HTML page requests during pagination (default 120 = 2 min)
NITTER_PAGE_DELAY=120

# Self-hosted Nitter (optional). Set after running docker compose up in nitter/.
# NITTER_LOCAL_URL=http://127.0.0.1:8080

# ---------------------------------------------------------------------------
# YouTube Transcript feature
# ---------------------------------------------------------------------------
# Uses QWEN_API_KEY (above) for both speech-to-text (qwen3-asr-flash) and
# summarization (qwen-plus) — no additional credentials required.
#
# YouTube cookie automation (required only when youtube-transcript-api fast path fails,
# i.e. for videos with no captions at all — rare for most YouTube content).
#
# One-time setup:
#   1. Export cookies from a YouTube-logged-in browser (Netscape format):
#        Chrome: "Get cookies.txt LOCALLY" extension → youtube.com → export
#   2. Upload:  scp cookies.txt root@47.239.66.248:/opt/tofuhouse/news_agent/yt_cookies.txt
#   3. Set both vars below, restart the app.
#   4. Call:    curl -X POST https://<your-domain>/transcript/cookies/setup
#        This loads the cookies into the persistent Chromium profile.
#   After that, APScheduler refreshes cookies automatically every 7 days.
#   Manual refresh: POST /transcript/cookies/refresh (admin only)
#
YOUTUBE_COOKIES_FILE=/opt/tofuhouse/news_agent/yt_cookies.txt
YT_BROWSER_PROFILE_DIR=/opt/tofuhouse/news_agent/yt_browser_profile
#
# Ensure ffmpeg is installed on the server (required by pydub for audio chunking):
#   apt-get install ffmpeg

# ---------------------------------------------------------------------------
# External script report API
# ---------------------------------------------------------------------------
# Used by external scripts to push run status and file attachments.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
REPORT_API_KEY=your-secret-key-here
