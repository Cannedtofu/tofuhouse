# Copy this file to .env and fill in your values

GEMINI_API_KEY=your_gemini_api_key_here

# Qwen (for browser-use agent) — get from Alibaba Cloud ModelStudio console
# Only qwen-vl-max is supported by browser-use; other Qwen models have schema issues
QWEN_API_KEY=your_qwen_api_key_here

SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_app_password
RECIPIENT_EMAIL=destination@example.com
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465

# Optional: override default database path
# DB_PATH=news.db
